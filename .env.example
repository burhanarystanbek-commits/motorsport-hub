# Any SQLAlchemy URL. SQLite for local use, PostgreSQL for deployments.
DATABASE_URL=sqlite:///./motorsport.db
# Cache is considered stale after this many hours (brief: 24)
STALE_AFTER_HOURS=24
# Season to sync (leave empty for the current calendar year)
SEASON=
# Contact string sent in the User-Agent header to sources
USER_AGENT=motorsport-hub/0.1 (+your-contact-url-or-email)
# Live timing via OpenF1. Empty = historical sessions only (live data needs an OpenF1 account)
OPENF1_USERNAME=
OPENF1_PASSWORD=
# Minimum seconds between upstream polls for live timing (shared by all clients)
LIVE_POLL_SECONDS=4
# Comma-separated allowed origins for the future frontend
CORS_ORIGINS=*
